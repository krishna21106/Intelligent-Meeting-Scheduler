# CNIP Network Manager - Environment Configuration Template
# Copy this file to .env before starting production deployment

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=cnip_nms
POSTGRES_USER=cnip_admin
POSTGRES_PASSWORD=CnipSecretPass123!
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Spring Boot Backend Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=c2VjdXJlX2NuaXBfbm1zX2p3dF9zZWNyZXRfa2V5XzIwMjZfZW50ZXJwcmlzZQ==
JWT_EXPIRATION_MS=86400000

# Telemetry Simulator Engine
NMS_SIMULATOR_ENABLED=true
NMS_SIMULATOR_POLLING_INTERVAL_MS=10000
NMS_SIMULATOR_RETENTION_DAYS=7

# Default Outbound Notification Webhook (Optional)
OUTBOUND_WEBHOOK_URL=https://webhook.cnip.network/alerts/v1/incoming
NOTIFICATION_RECIPIENT_EMAILS=noc@cnip.network,oncall@cnip.network
